# Copia este archivo a .env para probar local con `vercel dev`.
# En producción, carga estos MISMOS nombres en el dashboard de Vercel:
# Project Settings -> Environment Variables. No subas nunca un .env real
# a git (ya está en .gitignore).

# Tu clave de console.anthropic.com (Settings -> API Keys -> Create Key).
ANTHROPIC_API_KEY=sk-ant-...

# Opcional pero recomendado: cualquier texto largo y dificil de adivinar,
# el mismo valor va en el demo web (FOOD_ANALYZE_SECRET). No es seguridad
# real -- ver la nota en api/analyze-food.js -- solo frena bots genericos.
APP_SHARED_SECRET=elige-algo-dificil-de-adivinar
